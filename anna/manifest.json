{
  "schema": 2,
  "required_executas": [],
  "optional_executas": [],
  "host_capabilities": [
    "llm.complete",
    "aps.kv"
  ],
  "system_prompt_addendum": "Meme Lab finds existing reaction references for situations and can personalize a user-supplied static meme using a permitted photo through Anna image generation. Open with payload {comment: the user situation} for matching, or {action: personalize} for the image editor. Photos are chosen explicitly inside the app. Never promise exact likeness, identical background pixels, verified catalogue export rights or guaranteed earnings. Never include situations or photos in shared URLs. Serious requests should receive a sincere response rather than a meme.",
  "tags": [
    "memes",
    "reactions",
    "creative"
  ],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": [
        "https://memes.significanthobbies.com",
        "https://i.imgflip.com",
        "https://api.memegen.link",
        "https://media.giphy.com"
      ]
    },
    "views": [
      {
        "name": "main",
        "title": "Meme Lab",
        "default": true,
        "min_size": {
          "w": 320,
          "h": 320
        },
        "default_size": {
          "w": 960,
          "h": 720
        },
        "max_size": {
          "w": 1920,
          "h": 1600
        },
        "resizable": true,
        "movable": true,
        "single_instance": true
      }
    ],
    "host_api": {
      "llm": [
        "complete"
      ],
      "storage": [
        "get",
        "set",
        "list",
        "delete"
      ],
      "image": [
        "generate"
      ],
      "upload": [
        "inline"
      ],
      "files": [
        "upload_init",
        "upload_finalize",
        "download",
        "download_url",
        "list",
        "delete"
      ]
    },
    "csp_overrides": {
      "img-src": [
        "https:",
        "blob:"
      ],
      "connect-src": [
        "https:",
        "blob:"
      ]
    },
    "form_factors": [
      "desktop",
      "mobile"
    ]
  }
}
